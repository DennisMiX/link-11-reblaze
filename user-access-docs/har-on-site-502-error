-1-3\">\n    <a class=\"el-title uk-accordion-title\" href>Impact Detection + Event Video <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Automatically capture impacts with video context to eliminate unexplained damage and speed investigations.</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#5-0-1-1-4\">\n    <a class=\"el-title uk-accordion-title\" href>Speed Management <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Auto-enforce safe speed behavior based on configured event triggers to reduce risky driving and prevent high-impact events.</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#5-0-1-1-5\">\n    <a class=\"el-title uk-accordion-title\" href>Fleet Right-Sizing <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">See how your fleet is actually used to right‑size equipment, reduce rentals, and improve asset productivity.</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#5-0-1-1-6\">\n    <a class=\"el-title uk-accordion-title\" href>Multi‑Site Visibility <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Monitor safety, inspections, behavior, and equipment health across every site and shift from one system.</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#5-0-1-1-7\">\n    <a class=\"el-title uk-accordion-title\" href>Equipment Health & Maintenance <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Monitor equipment condition and fault trends to identify issues early, reduce unplanned downtime, and extend asset life.</div>                \n    \n    </div>\n</div>    \n</div>\n                \n            \n        \n    \n</div>\n        </div>    \n</div>\n                \n            \n        \n    \n</div>\n<div data-id=\"page#6\" class=\"uk-section-primary uk-section\" uk-scrollspy=\"target: [uk-scrollspy-class]; cls: uk-animation-slide-bottom-medium; delay: 200;\">\n    \n        \n        \n        \n            \n                                <div class=\"uk-container\">                \n                    \n<div class=\"uk-grid-margin uk-grid tm-grid-expand uk-child-width-1-1\" data-id=\"page#6-0\">\n    \n        \n<div class=\"uk-width-1-1\" data-id=\"page#6-0-0\">\n    \n        \n            \n            \n            \n                \n                    \n<h6 class=\"uk-h6 uk-margin-remove-bottom uk-text-center\" data-id=\"page#6-0-0-0\" data-element uk-scrollspy-class=\"uk-animation-fade\">\n    \n        \n                    Our Reach        \n        \n    \n</h6>\n<h2 class=\"uk-h2 uk-margin-remove-top uk-text-center\" data-id=\"page#6-0-0-1\" data-element uk-scrollspy-class>\n    \n        \n                    Trusted by global enterprise leaders        \n        \n    \n</h2>\n                \n            \n        \n    \n</div>\n    \n</div>\n<div class=\"uk-grid-margin uk-grid tm-grid-expand uk-child-width-1-1\" data-id=\"page#6-1\">\n    \n        \n<div class=\"uk-width-1-1\" data-id=\"page#6-1-0\">\n    \n        \n            \n            \n            \n                \n                    \n<div class=\"uk-slider-container uk-slider-container-offset uk-margin\" uk-slider=\"autoplay: 1;\" data-id=\"page#6-1-0-0\" data-element id=\"page#12\" uk-scrollspy-class=\"uk-animation-slide-bottom-small\">\n    <div class=\"uk-position-relative\">\n        \n            <div class=\"uk-slider-items uk-grid\">                                <div class=\"uk-width-1-1 uk-width-1-3@m uk-flex\">\n<div class=\"el-item uk-width-1-1 uk-card uk-card-primary uk-card-small uk-card-body uk-margin-remove-first-child\" data-id=\"page#6-1-0-0-0\">\n    \n        \n            \n                \n            \n            \n                                \n\n    <img class=\"el-image uk-inverse-light\" src=\"/images/by-need/operations/us/hero/quote_icon.png\" alt loading=\"lazy\" width=\"36\" height=\"30\" srcset=\"/images/by-need/operations/us/hero/quote_icon.png 36w\" sizes=\"(min-width: 36px) 36px\">\n    \n                \n                \n                    \n\n        \n        \n        \n    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\"><p class=\"uk-text-lead\">\"Powerfleet’s solution delivered not only the optimized safety and census benefits, but also significant incremental productivity improvements, above and beyond what our lift IDs were providing.\"</p>\n<img class=\"float-none\" src=\"/images/customer-logos/Walmart-Logo-White.png\" width=\"158\" height=\"35\" />\n<p><strong>Executive Manager</strong> <br>Walmart</p></div>        \n        \n        \n\n                \n                \n            \n        \n    \n</div></div>                                <div class=\"uk-width-1-1 uk-width-1-3@m uk-flex\">\n<div class=\"el-item uk-width-1-1 uk-card uk-card-primary uk-card-small uk-card-body uk-margin-remove-first-child\" data-id=\"page#6-1-0-0-1\">\n    \n        \n            \n                \n            \n            \n                                \n<div class=\"uk-inline-clip\">\n    <img class=\"el-image uk-inverse-light\" src=\"/images/by-need/operations/us/hero/quote_icon.png\" alt loading=\"lazy\" width=\"36\" height=\"30\" srcset=\"/images/by-need/operations/us/hero/quote_icon.png 36w\" sizes=\"(min-width: 36px) 36px\">\n        <img class=\"el-hover-image uk-transition-fade\" src=\"/images/customer-logos/flexivanlogo_dark.png\" alt loading=\"lazy\" width=\"1768\" height=\"342\" uk-cover srcset=\"/media/yootheme/cache/da/flexivanlogo_dark-dae568e6.png 768w, /media/yootheme/cache/f1/flexivanlogo_dark-f1f6113c.png 1024w, /media/yootheme/cache/32/flexivanlogo_dark-32443c4d.png 1366w, /media/yootheme/cache/70/flexivanlogo_dark-7049a99d.png 1600w, /images/customer-logos/flexivanlogo_dark.png 1768w\" sizes=\"(min-width: 1768px) 1768px\">    \n</div>                \n                \n                    \n\n        \n        \n        \n    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\"><p class=\"uk-text-lead\">\"Since deploying Powerfleet’s in-warehouse solution, we’ve seen a marked improvement in safety compliance and equipment utilization. The data has helped us proactively address operator behavior, avoid critical events, and reduce downtime.\"</p>\n<img class=\"float-none\" src=\"/images/customer-logos/Kautex-Logo_White.png\" width=\"181\" height=\"35\" />\n<p><strong>Operations Manager&nbsp;</strong> <br>Kautex</p></div>        \n        \n        \n\n                \n                \n            \n        \n    \n</div></div>                                <div class=\"uk-width-1-1 uk-width-1-3@m uk-flex\">\n<div class=\"el-item uk-width-1-1 uk-card uk-card-primary uk-card-small uk-card-body uk-margin-remove-first-child\" data-id=\"page#6-1-0-0-2\">\n    \n        \n            \n                \n            \n            \n                                \n\n    <img class=\"el-image uk-inverse-light\" src=\"/images/by-need/operations/us/hero/quote_icon.png\" alt loading=\"lazy\" width=\"36\" height=\"30\" srcset=\"/images/by-need/operations/us/hero/quote_icon.png 36w\" sizes=\"(min-width: 36px) 36px\">\n    \n                \n                \n                    \n\n        \n        \n        \n    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\"><p class=\"uk-text-lead\">\"Since operators are now accountable for their vehicles with Powerfleet, there is heightened awareness, and drivers are more careful of their surroundings. Continental Tire has forecasted a 33% improvement in vehicle-related damage in just the warehouse alone.\"</p>\n<img class=\"float-none\" src=\"/images/customer-logos/logo-conti-white-on-black.png\" width=\"171\" height=\"35\" />\n<p><strong>Fleet Manager</strong> <br>Continental Tire</p></div>        \n        \n        \n\n                \n                \n            \n        \n    \n</div></div>                            </div>\n        \n                \n<div class=\"uk-light uk-slidenav-container uk-position-bottom-right uk-position-small\" uk-inverse>\n    <a class=\"el-slidenav uk-slidenav-large\" href=\"#\" uk-slidenav-previous uk-slider-item=\"previous\"></a>    <a class=\"el-slidenav uk-slidenav-large\" href=\"#\" uk-slidenav-next uk-slider-item=\"next\"></a>\n</div>        \n    </div>\n    \n</div>\n                \n            \n        \n    \n</div>\n    \n</div>\n                                </div>                \n            \n        \n    \n</div>\n<div data-id=\"page#8\" id=\"onSiteDemosSection\" class=\"uk-section-secondary uk-position-relative\">\n        <div class=\"uk-background-norepeat uk-background-cover uk-background-center-center uk-background-fixed uk-section uk-section-small\" data-src=\"/images/cnx-on-site/just-demo.jpg\" uk-img>    \n        \n                <div class=\"uk-position-cover\" style=\"background-color: rgba(0, 0, 0, 0.31); background-image: linear-gradient(90deg,rgba(0, 0, 0, 0.49) 0%, rgba(255, 255, 255, 0) 100%);; background-clip: padding-box;\"></div>        \n        \n            \n                                <div class=\"uk-container uk-position-relative\">                \n                    \n<div class=\"uk-grid-margin uk-container\" data-id=\"page#8-0\">\n        <div class=\"uk-grid tm-grid-expand\" uk-grid>    \n        \n<div class=\"uk-grid-item-match uk-flex-middle uk-width-3-5@m\" data-id=\"page#8-0-0\">\n    \n        \n            \n            \n                        <div class=\"uk-panel uk-width-1-1\">            \n                \n                    \n<h1 class=\"uk-width-2xlarge uk-text-left@m uk-text-center\" data-id=\"page#8-0-0-0\" data-element id=\"page#13\">\n    \n        \n                    See what safer operations look like for your sites        \n        \n    \n</h1><div class=\"uk-panel uk-text-lead uk-margin-remove-top uk-width-xlarge uk-text-left@m uk-text-center\" data-id=\"page#8-0-0-1\" data-element id=\"page#14\">Consolidate everything onto a single platform. Full visibility. Fewer blind spots. Get started within weeks, not months.</div>\n                \n                        </div>            \n        \n    \n</div>\n<div class=\"uk-grid-item-match uk-width-2-5@m\" data-id=\"page#8-0-1\" id=\"page#15\">\n        <div class=\"uk-card-primary uk-card uk-card-body uk-flex uk-flex-middle\">    \n        \n            \n            \n                        <div class=\"uk-panel uk-width-1-1\">            \n                \n                    <div class=\"uk-panel uk-text-large uk-margin\" data-id=\"page#8-0-1-0\" data-element><p><strong>Request an obligation-free demo</strong></p></div><div data-id=\"page#8-0-1-1\" data-element><iframe id=\"onSiteDemoFrame\" src=\"https://insights.powerfleet.com/l/990812/2026-07-20/4by2td\" width=\"100%\" height=\"550\" type=\"text/html\" frameborder=\"0\" allowTransparency=\"true\" style=\"border: 0\"></iframe>\n<script type=\"text/javascript\" defer=\"\">\n    jQuery(document).ready(function ($) {\n        var iframe = document.getElementById('onSiteDemoFrame');\n        if (!iframe) {\n            return;\n        }\n\n        /*\n         * Removed: manual UTM/Conversion_Page concatenation.\n         * global-ytp-iframe.js already applies window.location.search and\n         * sets Conversion_Page on all insights.powerfleet.com iframes.\n         * Running both produced duplicate parameters that broke the thank-you redirect.\n         *\n         * Only inject Original_Lead_Source as a fallback if it is not already\n         * present on the URL (e.g. from a paid campaign parameter).\n         */\n        var iframeUrl = new URL(iframe.src);\n        var pageParams = new URLSearchParams(window.location.search);\n        var hasLeadSource = pageParams.has('Original_Lead_Source') || iframeUrl.searchParams.has('Original_Lead_Source');\n\n        if (!hasLeadSource) {\n            iframeUrl.searchParams.set('Original_Lead_Source', 'na-on-site-demo-b');\n            iframe.src = iframeUrl.toString();\n        }\n    });\n</script></div>\n                \n                        </div>            \n        \n        </div>    \n</div>\n        </div>    \n</div>\n                                </div>                \n            \n        \n        </div>\n    \n</div>\n<div data-id=\"page#9\" id=\"page#17\" class=\"uk-section-muted uk-section uk-section-large\" uk-scrollspy=\"target: [uk-scrollspy-class]; cls: uk-animation-slide-bottom-medium; delay: 200;\">\n    \n        \n        \n        \n            \n                \n                    \n<div class=\"uk-grid-margin-small uk-container\" data-id=\"page#9-0\">\n        <div class=\"uk-grid uk-flex-center uk-grid-small\" uk-grid>    \n        \n<div class=\"uk-width-1-1@s uk-width-1-6@m\" data-id=\"page#9-0-0\">\n    \n        \n            \n            \n            \n                \n                    \n                \n            \n        \n    \n</div>\n<div class=\"uk-width-3-4@s uk-width-2-3@m\" data-id=\"page#9-0-1\">\n    \n        \n            \n            \n            \n                \n                    \n<h6 class=\"uk-h6 uk-margin-remove-bottom uk-text-center\" data-id=\"page#9-0-1-0\" data-element uk-scrollspy-class=\"uk-animation-fade\">\n    \n        \n                    FAQ        \n        \n    \n</h6>\n<h2 class=\"uk-h2 uk-text-center\" data-id=\"page#9-0-1-1\" data-element uk-scrollspy-class=\"uk-animation-slide-bottom\">\n    \n        \n                    What on‑site leaders ask most about safety, compliance, and equipment operations        \n        \n    \n</h2>\n<div class=\"uk-accordion-default\" uk-accordion=\"collapsible: false;\" data-id=\"page#9-0-1-2\" data-element id=\"page#16\" uk-scrollspy-class=\"uk-animation-fade\">\n        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-0\">\n    <a class=\"el-title uk-accordion-title\" href>1. How can we proactively prevent forklift and pedestrian incidents across our facilities? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Most incidents occur in blind corners, congested aisles, or fast‑moving zones. Powerfleet helps prevent these events by strengthening enforcement with real‑time proximity alerts, pedestrian detection, and impact monitoring. These capabilities reduce risk, eliminate blind spots, and support more consistent operator behavior — helping teams achieve up to 70% fewer safety incidents across operations.</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-1\">\n    <a class=\"el-title uk-accordion-title\" href>2. How do we ensure pre‑shift inspections are actually completed — not rushed or skipped? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Digital inspections make compliance enforceable. Powerfleet replaces paper forms with guided, digital pre‑shift checklists, ensures operators cannot bypass required steps, and can automatically restrict equipment access until inspections are completed. This helps organizations reach 100% regulatory compliance on required checks, with full audit trails.\n</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-2\">\n    <a class=\"el-title uk-accordion-title\" href>3. How can we ensure only trained and certified operators use our equipment? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Powerfleet verifies operator identity and certification status at the moment of use. Equipment remains locked until the operator meets training and certification requirements. This eliminates uncertified usage, prevents PIN sharing, and centralizes certification management for safer, more consistent operations.\n</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-3\">\n    <a class=\"el-title uk-accordion-title\" href>4. How do we identify the source of damage to racks, equipment, and product? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">With impact detection and event‑triggered video, Powerfleet captures WHEN, WHERE, and HOW each impact occurs. Supervisors get instant visibility to address root causes, coach operators, reduce damage rates by up to 80%, and prevent minor hits from compounding into major structural or inventory loss.\n</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-4\">\n    <a class=\"el-title uk-accordion-title\" href>5. How do we reduce equipment downtime caused by missed defects or incomplete inspections? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">\nPowerfleet surfaces issues early with digital inspections and automated defect reporting, ensuring problems are found at the start of shifts, not mid‑operation. Maintenance teams receive real‑time alerts to prioritize repairs, reduce unplanned downtime, and stay ahead of equipment failures.\n</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-5\">\n    <a class=\"el-title uk-accordion-title\" href>6. How can we right‑size our forklift fleet and reduce unnecessary rentals or leases? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Many organizations over-lease equipment due to limited visibility into actual usage. Powerfleet provides utilization insights to identify over-capacity, return unnecessary rentals, and support data-driven capital decisions. Leaders gain the visibility needed to right-size fleets and reduce avoidable equipment costs.</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-6\">\n    <a class=\"el-title uk-accordion-title\" href>7. How do we maintain consistent safety and compliance standards across every shift and facility? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">\nPowerfleet centralizes visibility across all sites and shifts, giving leaders real‑time insights into safety performance, checklist completion, operator behavior, and incidents — even overnight or on weekends. This eliminates variability across locations and helps scale best practices enterprise‑wide.\n</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-7\">\n    <a class=\"el-title uk-accordion-title\" href>8. How can we introduce safety technology without creating resistance or a “Big Brother” perception? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Powerfleet is built to enable a coaching‑forward, prevention‑focused culture, not punishment. Data and alerts support constructive conversations, reinforce consistent expectations, and help supervisors guide safer behaviors. This builds adoption and trust across teams.</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-8\">\n    <a class=\"el-title uk-accordion-title\" href>9. Will Powerfleet work with older or mixed‑brand forklifts and equipment? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Yes. Powerfleet is designed to integrate with a wide range of equipment types, ages, and OEM brands, making it ideal for operations with mixed fleets or legacy assets. No major hardware overhaul or equipment replacement is required to get started.\n</div>                \n    \n    </div>\n</div>        \n<div class=\"el-item\" data-id=\"page#9-0-1-2-9\">\n    <a class=\"el-title uk-accordion-title\" href>10. How quickly can we expect ROI from Powerfleet On‑Site? <span uk-accordion-icon></span></a>\n\n    <div class=\"uk-accordion-content\">\n    \n                <div class=\"el-content uk-panel\">Organizations commonly achieve measurable operational improvements shortly after deployment — including reduced incidents, lower damage costs, improved utilization, and strengthened compliance.</div>                \n    \n    </div>\n</div>    \n</div>\n                \n            \n        \n    \n</div>\n<div class=\"uk-width-1-1@s uk-width-1-6@m\" data-id=\"page#9-0-2\">\n    \n        \n            \n            \n            \n                \n                    \n                \n            \n        \n    \n</div>\n        </div>    \n</div>\n                \n            \n        \n    \n</div>\n\n                \n            </main>\n\n            <div id=\"module-347\" class=\"builder\"><!-- Builder #module-347 --><style class=\"uk-margin-remove-adjacent\" data-id=\"module-347#root-style\">@media (max-width: 768px){#module-347\\#0 .el-content{padding: 0 10px; font-size: 14px}#module-347\\#0 .uk-button::after{left: 30px;}}#preFooterContactRow{position: relative; z-index: 2}</style>\n<div data-id=\"module-347#0\