\"phone-error\");\n        }\n    }\n\n    if ($phoneInput.length && window.intlTelInput) {\n        iti = window.intlTelInput($phoneInput[0], {\n            initialCountry: getInitialCountryCode(),\n            separateDialCode: true,\n            strictMode: true,\n            autoPlaceholder: \"polite\",\n            useFullscreenPopup: false\n        });\n\n        // Sync: Phone Flag -> Country Dropdown\n        $phoneInput[0].addEventListener(\"countrychange\", function() {\n            const selectedCountryData = iti.getSelectedCountryData();\n            const fullCountryName = countryNames[selectedCountryData.iso2.toUpperCase()];\n            if (fullCountryName) {\n                const $targetOption = $countrySelect.find(\"option\").filter(function() {\n                    return $(this).text().trim() === fullCountryName;\n                });\n                if ($targetOption.length) {\n                    $countrySelect.val($targetOption.val()).trigger('change.select2').trigger('change');\n                }\n            }\n        });\n    }\n\n    // 4. Sync: Dropdown -> Phone Flag\n    $countrySelect.on(\"change\", function() {\n        const selectedText = $(this).find(\"option:selected\").text().trim();\n        const normalizedSelectedText = normalizeCountryName(selectedText);\n        const code = Object.keys(countryNames).find(function(key) {\n            const normalizedMappedName = normalizeCountryName(countryNames[key]);\n            const normalizedAlias = normalizeCountryName(countryNameAliases[normalizedMappedName]);\n\n            return normalizedMappedName === normalizedSelectedText || normalizedAlias === normalizedSelectedText;\n        });\n\n        if (code && iti) iti.setCountry(code.toLowerCase());\n    });\n\n    // 5. Form Submission: Validation + Full Number Format\n    $form.on(\"submit\", function(e) {\n        let hasValidationError = false;\n\n        if (iti) {\n            if (validationUI && typeof validationUI.clearField