losest(\"form\");\n    let iti;\n\n    function normalizeCountryCode(value) {\n        if (typeof value !== \"string\") {\n            return \"\";\n        }\n\n        const normalizedValue = value.trim().toUpperCase();\n\n        if (!/^[A-Z]{2}$/.test(normalizedValue) || !countryNames[normalizedValue]) {\n            return \"\";\n        }\n\n        return normalizedValue;\n    }\n\n    function normalizeCountryName(value) {\n        return (value || \"\")\n            .toString()\n            .normalize(\"NFD\")\n            .replace(/[\\u0300-\\u036f]/g, \"\")\n            .replace(/&/g, \"and\")\n            .replace(/[^a-zA-Z0-9]+/g, \" \")\n            .trim()\n            .toLowerCase();\n    }\n\n    function findCountryOption(countryName) {\n        if (!$countrySelect.length || !countryName) {\n            return $();\n        }\n\n        const normalizedCountryName = normalizeCountryName(countryName);\n        const aliasCountryName = countryNameAliases[normalizedCountryName];\n        const candidateNames = [countryName];\n\n        if (aliasCountryName) {\n            candidateNames.push(aliasCountryName);\n        }\n\n        const normalizedCandidateNames = candidateNames.map(function(name) {\n            return normalizeCountryName(name);\n        });\n\n        return $countrySelect.find(\"option\").filter(function() {\n            return normalizedCandidateNames.indexOf(normalizeCountryName($(this).text())) !== -1;\n        }).first();\n    }\n\n    function applyCountrySelection(countryCode) {\n        const normalizedCountryCode = normalizeCountryCode(countryCode);\n\n        if (!normalizedCountryCode) {\n            return false;\n        }\n\n        const countryName = countryNames[normalizedCountryCode];\n\n        if (!countryName) {\n            return false;\n        }\n\n        if (iti) {\n            iti.setCountry(normalizedCountryCode.toLowerCase());\n        }\n\n        if ($countrySelect.length) {\n            const $targetOption = findCountryOption(countryName);\n\n            if ($targetOption.length) {\n                $countrySelect.find(\"option\").removeAttr(\"selected\").prop(\"selected\", false);\n                $targetOption.prop(\"selected\", true).attr(\"selected\", \"selected\");\n                $countrySelect.val($targetOption.val()).trigger(\"change.select2\").trigger(\"change\");\n            }\n        }\n\n        return true;\n    }\n\n    function extractCountryFromLocale(locale) {\n        if (typeof locale !== \"string\") {\n            return \"\";\n        }\n\n        const localeParts = locale.replace(\"_\", \"-\").split(\"-\");\n\n        for (let index = localeParts.length - 1; index >= 0; index -= 1) {\n            const normalizedCountryCode = normalizeCountryCode(localeParts[index]);\n\n            if (normalizedCountryCode) {\n                return normalizedCountryCode;\n            }\n        }\n\n        return \"\";\n    }\n\n    function getBrowserCountryCandidates() {\n        const candidates = [];\n\n        function addCandidate(countryCode) {\n            const normalizedCountryCode = normalizeCountryCode(countryCode);\n\n            if (normalizedCountryCode && candidates.indexOf(normalizedCountryCode) === -1) {\n                candidates.push(normalizedCountryCode);\n            }\n        }\n\n        const languages = Array.isArray(navigator.languages) ? navigator.languages : [];\n        languages.concat([navigator.language, document.documentElement.lang]).forEach(function(locale) {\n            addCandidate(extractCountryFromLocale(locale));\n        });\n\n        if (window.Intl && typeof window.Intl.DateTimeFormat === \"function\") {\n            const resolvedOptions = window.Intl.DateTimeFormat().resolvedOptions();\n            addCandidate(timeZoneCountryMap[resolvedOptions.timeZone]);\n        }\n\n        return candidates;\n    }\n\n    function detectCountryCodeFromSource(source) {\n        return new Promise(function(resolv